{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Desk",
  "version": "0.1.0",
  "identifier": "dev.taiji.ai-desk",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AI Desk",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "http://127.0.0.1:8787/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhGNjRBMUJFMzA2NzEwNTQKUldSVUVHY3d2cUZrajJCbnBFTTFBSEZWRDBqN1ZGZVZ2UEtGR3ExSDRGdWc2WXE5UkhPOXkzUHEK",
      "dangerousInsecureTransportProtocol": true
    }
  }
}
